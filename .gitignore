# 注意：git 的 .gitignore 不支持行尾注释（# 只在行首有效），
#      所以每条规则单独成行，说明写在规则上方或下方。

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
venv/
.venv/

# ── 数据库 ────────────────────────────────────────────
*.db
*.db-journal
*.db-wal

# ── ChromaDB 向量库 ───────────────────────────────────
data/chromadb/

# ── 环境变量 ──────────────────────────────────────────
.env
.env.local
.env.*.local

# ── 生成产物 ──────────────────────────────────────────
# graphify 代码图谱的中间产物与缓存
graphify-out/

# ── 编辑器临时文件 ────────────────────────────────────
# Typora 钩子日志（曾占 4.8MB）
Typora_Hook_Log.txt

# ── agent 本地状态 ────────────────────────────────────
.workbuddy/

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 临时文件 ──────────────────────────────────────────
*.log
*.tmp
.cache/

# ── Node ──────────────────────────────────────────────
node_modules/
